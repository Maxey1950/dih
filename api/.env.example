NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://revival:revival@127.0.0.1:5432/revival?schema=public
# At least 32 random characters, e.g. `openssl rand -base64 48`
COOKIE_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# COOKIE_SECURE defaults to true in production (and then cookies use the __Host- prefix)
# COOKIE_SECURE=false
SESSION_TTL_DAYS=30
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=127.0.0.1,::1
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1 minute
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GAME_CREATE_MAX=20
