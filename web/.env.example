# Server-side only. Where Next.js proxies same-origin /api/* requests.
# Defaults to http://127.0.0.1:4000 in `next dev`. Leave unset in production
# if your reverse proxy routes /api/* to the API service directly.
API_ORIGIN=http://127.0.0.1:4000

# Public site origin, used only for page metadata (Open Graph URLs).
SITE_URL=
