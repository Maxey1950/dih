// Accounts, sessions, social graph and games.
// Catalog, economy, groups, forum and messages come in later phases.
// Nothing here is derived from, or migrated from, the AlphaBlox MongoDB models.
//
// Constraints Prisma cannot express (CHECKs) are added by hand in the
// migration SQL; see prisma/migrations/*_accounts_sessions_social.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Keep roles simple. Permissions are derived from the role only, never from user ids.
enum UserRole {
  user
  moderator
  admin
}

enum Theme {
  light
  dark
}

enum FriendshipStatus {
  pending
  accepted
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Stable numeric id for the game runtime (RFD expects integer user ids).
  /// Allocated by the database; never chosen by clients.
  numericId          Int       @unique @default(autoincrement()) @map("numeric_id")
  /// Display form of the login name, e.g. "Builderman". Rules: shared/src/validation.ts.
  username           String    @db.VarChar(20)
  /// Lower-cased username; unique, used for login and duplicate checks.
  usernameNormalized String    @unique @map("username_normalized") @db.VarChar(20)
  /// Optional friendly name shown on the profile. Defaults to the username in the API.
  displayName        String?   @map("display_name") @db.VarChar(32)
  /// Profile "blurb".
  description        String    @default("") @db.VarChar(1000)
  /// Unused: registration does not collect email (no verification/recovery yet).
  email              String?   @unique @db.VarChar(254)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  /// argon2id PHC string. Never selected into API responses.
  passwordHash       String    @map("password_hash")
  role               UserRole  @default(user)
  theme              Theme     @default(light)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// Updated at most every PRESENCE_WRITE_INTERVAL (see api/src/auth/session.ts).
  lastOnlineAt       DateTime? @map("last_online_at")
  bannedUntil        DateTime? @map("banned_until")
  banReason          String?   @map("ban_reason") @db.VarChar(500)

  sessions           Session[]
  games              Game[]
  friendshipsAsLow   Friendship[] @relation("FriendshipLow")
  friendshipsAsHigh  Friendship[] @relation("FriendshipHigh")
  friendRequestsSent Friendship[] @relation("FriendshipRequester")
  following          Follow[]     @relation("Follower")
  followers          Follow[]     @relation("Following")
  joinTickets        JoinTicket[]

  @@index([lastOnlineAt])
  @@map("users")
}

/// Server-side session. The browser holds only a random 256-bit token in an
/// HttpOnly cookie; the database stores its SHA-256 hash, so a database leak
/// does not leak usable session tokens.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")
  /// Truncated User-Agent, for a future "active sessions" page. No IP is stored.
  userAgent  String?  @map("user_agent") @db.VarChar(256)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One row per unordered pair of users. userLowId < userHighId is enforced by
/// a CHECK constraint, so (A,B) and (B,A) cannot both exist and nobody can
/// befriend themselves.
model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  userLowId   String           @map("user_low_id") @db.Uuid
  userHighId  String           @map("user_high_id") @db.Uuid
  /// Who sent the request; must be one of the pair (CHECK constraint).
  requesterId String           @map("requester_id") @db.Uuid
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")

  userLow   User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh  User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@index([requesterId])
  @@map("friendships")
}

/// Directed follow edge. Composite primary key prevents duplicates; a CHECK
/// constraint prevents following yourself.
model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

/// A game/place listing. Owned by exactly one User (the creator); only the
/// creator or an admin may edit it. Live state (servers, player counts) is
/// NOT stored here; it lives in GameServer and is aggregated at read time.
model Game {
  id           String    @id @default(uuid()) @db.Uuid
  /// Numeric place identifier handed to the game runtime later (RFD place
  /// ids are numeric). Allocated by the database; never set by clients.
  placeId      Int       @unique @default(autoincrement()) @map("place_id")
  name         String    @db.VarChar(50)
  description  String    @default("") @db.VarChar(1000)
  creatorId    String    @map("creator_id") @db.Uuid
  creator      User      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  genre        String?   @db.VarChar(50)
  maxPlayers   Int       @default(12) @map("max_players")
  /// Set by seeds/admins only (no uploads yet). null = site default thumbnail.
  thumbnailUrl String?   @map("thumbnail_url") @db.VarChar(512)
  isPublic     Boolean   @default(false) @map("is_public")
  /// Admin-curated flag used by the "Featured" sort.
  isFeatured   Boolean   @default(false) @map("is_featured")
  visits       BigInt    @default(0)
  upVotes      Int       @default(0) @map("up_votes")
  downVotes    Int       @default(0) @map("down_votes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// Soft delete ("unpublish and remove"). Deleted games are hidden from
  /// everyone except admins; data is kept for moderation/audit.
  deletedAt    DateTime? @map("deleted_at")

  servers     GameServer[]
  joinTickets JoinTicket[]

  @@index([creatorId])
  @@index([isPublic, deletedAt, updatedAt])
  @@index([isFeatured])
  @@map("games")
}

enum GameServerStatus {
  starting
  online
  draining
  offline
}

/// A live game-server instance (later: an RFD v347 server process).
/// Authenticates to /api/internal/servers/* with a random credential; only
/// SHA-256(credential) is stored. host/port are INTERNAL routing data and are
/// never included in public API responses.
model GameServer {
  id              String           @id @default(uuid()) @db.Uuid
  gameId          String           @map("game_id") @db.Uuid
  game            Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  credentialHash  String           @unique @map("credential_hash") @db.Char(64)
  host            String           @db.VarChar(255)
  port            Int
  status          GameServerStatus @default(offline)
  playerCount     Int              @default(0) @map("player_count")
  maxPlayers      Int              @map("max_players")
  startedAt       DateTime?        @map("started_at")
  lastHeartbeatAt DateTime?        @map("last_heartbeat_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  joinTickets JoinTicket[]

  @@index([gameId, status, lastHeartbeatAt])
  @@index([status, lastHeartbeatAt])
  @@map("game_servers")
}

/// One-time, short-lived authorization for ONE user to join ONE game on ONE
/// selected game server. The raw ticket ("rvjt_" + 256 random bits) is shown
/// to the browser once and never stored; only SHA-256(ticket) is kept.
/// Lifecycle: issued -> (optionally) resolved by the launcher -> redeemed by
/// the game server, or revoked/expired. Every read checks expiry directly.
model JoinTicket {
  id                 String     @id @default(uuid()) @db.Uuid
  tokenHash          String     @unique @map("token_hash") @db.Char(64)
  userId             String     @map("user_id") @db.Uuid
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId             String     @map("game_id") @db.Uuid
  game               Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  serverId           String     @map("server_id") @db.Uuid
  server             GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt          DateTime   @default(now()) @map("created_at")
  expiresAt          DateTime   @map("expires_at")
  /// First successful launcher resolve (does NOT consume the ticket).
  launcherResolvedAt DateTime?  @map("launcher_resolved_at")
  resolveCount       Int        @default(0) @map("resolve_count")
  /// Set exactly once, atomically, by the game server's redemption.
  redeemedAt         DateTime?  @map("redeemed_at")
  revokedAt          DateTime?  @map("revoked_at")

  @@index([userId, redeemedAt, revokedAt, expiresAt])
  @@index([serverId, redeemedAt, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("join_tickets")
}
