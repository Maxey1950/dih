// Phase 1 schema: accounts, sessions and games only.
// Catalog, economy, groups, forum and messages come in later phases.
// Nothing here is derived from, or migrated from, the AlphaBlox MongoDB models.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  moderator
  admin
}

enum Theme {
  light
  dark
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Display form, e.g. "Builderman".
  username           String    @db.VarChar(20)
  /// Lower-cased username used for uniqueness and lookups.
  usernameNormalized String    @unique @map("username_normalized") @db.VarChar(20)
  email              String?   @unique @db.VarChar(254)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  /// argon2id hash. Never selected into API responses.
  passwordHash       String    @map("password_hash")
  role               UserRole  @default(user)
  blurb              String    @default("") @db.VarChar(1000)
  theme              Theme     @default(light)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lastSeenAt         DateTime? @map("last_seen_at")
  bannedUntil        DateTime? @map("banned_until")
  banReason          String?   @map("ban_reason") @db.VarChar(500)

  sessions Session[]
  games    Game[]

  @@map("users")
}

/// Server-side session. The browser holds only a random token in a
/// Secure/HttpOnly/SameSite cookie; the database stores its SHA-256 hash,
/// so a database leak does not leak usable session tokens.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Coarse metadata for the "active sessions" page; optional.
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A game/place listing. Live player counts come from the game-server
/// registry (Phase 2), not from this table.
model Game {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  description  String   @default("") @db.VarChar(4000)
  creatorId    String   @map("creator_id") @db.Uuid
  creator      User     @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  genre        String?  @db.VarChar(50)
  maxPlayers   Int      @default(12) @map("max_players")
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(512)
  isPublic     Boolean  @default(false) @map("is_public")
  visits       BigInt   @default(0)
  upVotes      Int      @default(0) @map("up_votes")
  downVotes    Int      @default(0) @map("down_votes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([creatorId])
  @@index([isPublic, updatedAt])
  @@map("games")
}
