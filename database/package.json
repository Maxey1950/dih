{
  "name": "@revival/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema and migrations (Prisma). No donor MongoDB data is imported.",
  "type": "module",
  "scripts": {
    "validate": "prisma validate",
    "format": "prisma format",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
